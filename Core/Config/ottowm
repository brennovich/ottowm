# OttoWM's' example configuration
#
# This simple declarative file maps out key combos and supported actions.

# Go to a workspace: 4 Workspaces example
lopt-1 = switch-to-workspace 1
lopt-2 = switch-to-workspace 2
lopt-3 = switch-to-workspace 3
lopt-4 = switch-to-workspace 4

# Send the current focused window to a workspace: 4 workspaces example
lopt-shift-1 = move-window-to-workspace 1
lopt-shift-2 = move-window-to-workspace 2
lopt-shift-3 = move-window-to-workspace 3
lopt-shift-4 = move-window-to-workspace 4

# Quit OttoWM, putting every parked window back where it was
hyper-q = quit

# Reload the config file and the bindings it names
hyper-r = restart
